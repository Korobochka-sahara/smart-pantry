# Docker Compose configuration. Copy to .env in this repository's root.
POSTGRES_DB=smart_pantry
POSTGRES_USER=smart_pantry
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-an-independent-random-secret-at-least-32-bytes
MINERU_TIER=standard
# Ollama runs on the Docker host; make it reachable from containers.
OLLAMA_HOST=http://host.docker.internal:11434
