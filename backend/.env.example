# Local backend configuration; copy to .env and replace SECRET_KEY.
DATABASE_URL=postgresql://smart_pantry:smart_pantry_password@localhost:5433/smart_pantry
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
MINERU_BASE_URL=http://127.0.0.1:8001
# Ollama defaults to localhost:11434 when not explicitly configured.
# In Docker Compose this is set to host.docker.internal by compose.